# Conexão com o Postgres.
# Local (via docker-compose up -d):
DATABASE_URL="postgresql://postgres:password@localhost:5432/professoros?schema=public"

# Segredo usado para assinar o cookie de sessão.
# Obrigatório em produção — a aplicação recusa iniciar a sessão sem ele.
# Gere o seu com:  openssl rand -base64 32
AUTH_SECRET=""
