// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Settings {
  id       String @id @default(cuid())
  password String // Hashed admin password
}

model Institution {
  id      String  @id @default(cuid())
  name    String  // Ex: "Fatec Franca"
  classes Class[]
}

model Semester {
  id      String  @id @default(cuid())
  name    String  // Ex: "2º Semestre/2026"
  classes Class[]
}

model Subject {
  id      String  @id @default(cuid())
  name    String  // Ex: "Redes de Computadores"
  classes Class[]
}

model Class {
  id                String   @id @default(cuid())
  institutionId     String?
  semesterId        String
  subjectId         String
  turmaName         String?  // Ex: "Turma A", "N1A"
  schedule          String?  // Ex: "Quinta de manhã", "Terça à noite"
  professor         String   // Ex: "Prof. Me. DAVI MAXMILLAN"
  calculationMethod String   @default("SUM") // "SUM" ou "AVERAGE"
  startDate         DateTime?
  endDate           DateTime?
  daysOfWeek        String?  // JSON string como "[1, 3]" para Seg e Qua
  institution       Institution? @relation(fields: [institutionId], references: [id])
  semester          Semester @relation(fields: [semesterId], references: [id])
  subject           Subject  @relation(fields: [subjectId], references: [id])
  enrollments       Enrollment[]
  activities        Activity[]
  scheduleEntries   ScheduleEntry[]
  groupWorks        GroupWork[]
  classNotes        ClassNote[]
}

model Student {
  id          String   @id @default(cuid())
  name        String
  rgm         String?  @unique
  enrollments Enrollment[]
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  grades    Grade[]
  attendances AttendanceRecord[]
  enrollmentDate DateTime?
  absences  Int      @default(0)
  afGrade   Float?
  finalAvg  Float?
  status    String?
  notes     String?  // Anotação privada do professor sobre este aluno nesta turma
  groupMembers GroupMember[]
}

model Activity {
  id        String   @id @default(cuid())
  classId   String
  bimester  Int      @default(1) // 1 ou 2
  name      String   // Ex: "Atividade 1", "Prova"
  weight    Float    // Peso da atividade (Ex: 2.0, 5.0)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  grades    Grade[]
  createdAt DateTime @default(now())
  groupWork GroupWork?
}

model Grade {
  id           String   @id @default(cuid())
  enrollmentId String
  activityId   String
  value        Float    // A nota bruta (ex: 10)
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  activity     Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, activityId])
}

model AttendanceRecord {
  id           String   @id @default(cuid())
  enrollmentId String
  date         DateTime
  present      Boolean  @default(true)
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, date])
}

model ScheduleEntry {
  id          String   @id @default(cuid())
  classId     String
  date        DateTime
  content     String?
  notes       String?
  isHoliday   Boolean  @default(false)
  holidayName String?
  rowColor    String?  // Permite customizar a cor da linha (ex: para pontes, feriados locais extras)
  driveLink   String?  // Link do Google Drive para o material da aula
  
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, date])
}

model GroupWork {
  id          String   @id @default(cuid())
  classId     String
  activityId  String?  @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  activity    Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  groups      Group[]
}

model Group {
  id          String        @id @default(cuid())
  groupWorkId String
  name        String
  theme       String?
  notes       String?       // Feedback/Notas do professor sobre o grupo
  
  groupWork   GroupWork     @relation(fields: [groupWorkId], references: [id], onDelete: Cascade)
  members     GroupMember[]
}

model GroupMember {
  id           String     @id @default(cuid())
  groupId      String
  enrollmentId String
  
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([groupId, enrollmentId])
}

model ClassNote {
  id        String   @id @default(cuid())
  classId   String
  title     String?
  content   String
  color     String?  // Ex: "#1e293b", "#7c3aed"
  pinned    Boolean  @default(false)
  label     String?  // Ex: "recado", "palestra", "ideia", "urgente"
  fontSize  Int      @default(14)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
}
